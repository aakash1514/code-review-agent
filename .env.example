# Copy to .env (git-ignored) and fill in. config.py reads every value from
# the environment; on AWS, ECS sets these (secrets from Secrets Manager).
# Leave a line empty to use config.py's default.

# Where the SQLite DB and knowledge_graph_*.json live. Default ./data
DATA_DIR=

# GitHub App
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# Either the key itself (one line, newlines written as \n) ...
GITHUB_PRIVATE_KEY=
# ... or a path to the .pem file (local dev). Default ./github-app-private-key.pem
GITHUB_PRIVATE_KEY_PATH=

# Dashboard login (the GitHub App's OAuth credentials)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Default http://localhost:8000/auth/callback
GITHUB_OAUTH_REDIRECT_URI=
# Default http://localhost:5173
DASHBOARD_BASE_URL=

# Groq
GROQ_API_KEY=
# Defaults openai/gpt-oss-120b and openai/gpt-oss-20b
GROQ_MODEL_REASONING=
GROQ_MODEL_LIGHT=

# Embeddings: local | hf_api | bedrock. Default local
EMBEDDING_PROVIDER=
# Only for EMBEDDING_PROVIDER=hf_api
HF_TOKEN=

# AWS / Bedrock. Credentials come from AWS_PROFILE (laptop) or the ECS task role.
# Default ap-south-1
AWS_REGION=
# Default: AWS_REGION
BEDROCK_EMBED_REGION=
# 256 | 512 | 1024. Default 512
BEDROCK_EMBED_DIM=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=

# Default sqlite:///<DATA_DIR>/review_agent.db
DATABASE_URL=

# Review scope. Defaults 20000 and 25
MAX_PATCH_CHARS=
MAX_FILES_PER_REVIEW=

# Set on AWS only (CloudFront adds it as the X-Origin-Verify header). Empty = off.
ORIGIN_VERIFY_SECRET=